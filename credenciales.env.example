# ============================================================================
#  CREDENCIALES  —  copiá este archivo a  credenciales.env  y pegá tus valores
# ============================================================================
#
#  Son CUATRO datos. Nada más. El resto lo saca el instalador solo.
#
#  ⚠️  credenciales.env está en .gitignore. Nunca lo subas a GitHub,
#      no lo pegues en un chat y no lo dejes a la vista si grabás pantalla.
#
#  ¿De dónde sale cada uno? → docs/01-meta.md  y  docs/02-supabase.md
# ============================================================================


# ─── 1. SUPABASE ────────────────────────────────────────────────────────────
# Personal Access Token. Un clic:
#   https://supabase.com/dashboard/account/tokens  →  "Generate new token"
# Con esto el instalador crea el proyecto, saca las llaves y aplica las
# ~39 migraciones solo. Empieza con "sbp_".
SUPABASE_ACCESS_TOKEN=

# (OPCIONAL) Si YA tenés un proyecto de Supabase y no querés que cree uno
# nuevo, pegá acá su Project Ref (la parte del medio de la URL del dashboard:
# https://supabase.com/dashboard/project/<ESTO-DE-ACA>).
# Si lo dejás vacío, el instalador crea un proyecto nuevo.
SUPABASE_PROJECT_REF=


# ─── 2. META / WHATSAPP ─────────────────────────────────────────────────────
# App ID y App Secret de tu app de Meta.
#   developers.facebook.com → tu app → Configuración → Básica
META_APP_ID=
META_APP_SECRET=

# Token permanente del System User, con los permisos
# whatsapp_business_messaging y whatsapp_business_management.
#   business.facebook.com → Configuración del negocio → Usuarios del sistema
# (El token del "Quickstart" dura 24 h y NO sirve — tiene que ser el del
#  System User, que no vence. El check te avisa si pusiste el equivocado.)
META_ACCESS_TOKEN=

# (OPCIONAL) WABA ID. Si lo dejás vacío el instalador intenta descubrirlo solo;
# si tu token no tiene permiso para listarlo, te lo va a pedir.
#   developers.facebook.com → tu app → WhatsApp → Configuración de la API
META_WABA_ID=

# (OPCIONAL) PIN de 6 dígitos de la verificación en dos pasos del número.
# Es el que YA tiene el número, no uno nuevo. Sirve para registrarlo, que es
# lo que le dice a Meta que esta app reclama ese número.
# Si lo dejás acá, no te lo vuelve a pedir cada vez que corrés el paso 2.
# Si no lo recordás: se resetea desde el Business Manager (por API no se puede).
META_PIN=


# ─── 3. TU DOMINIO ──────────────────────────────────────────────────────────
# La URL pública donde va a vivir el CRM, con https:// y SIN barra final.
# Meta necesita alcanzarla para verificar el webhook, así que tiene que estar
# arriba ANTES de correr el paso 2.
#
#   · Ya lo deployaste           →  https://crm.tudominio.com
#   · Todavía no, estás probando →  la URL del túnel (ver docs/03-deploy.md)
PUBLIC_URL=

# (OPCIONAL) Palabra secreta que Meta y el CRM comparten para dar el apretón
# de manos del webhook. Podés inventar cualquier cosa. Si la dejás vacía,
# el instalador genera una al azar (mejor que "123456").
VERIFY_TOKEN=
